# ── Contact form ──────────────────────────────────────────────────────
# The form works out of the box: it POSTs to FormSubmit, which emails
# prajol@kubegraf.io. No key, no account. The address only has to be
# activated once, by clicking the "Activate Form" link in the email
# FormSubmit sends on the first submission.
#
# Set these only to move delivery elsewhere (Formspree, Web3Forms, your
# own handler). Any service that accepts a JSON POST works.
#
#   VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
#   VITE_FORM_ACCESS_KEY=        # only if the service needs one
#
# Copy to `.env` to use. Vite only exposes VITE_* variables.

VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
